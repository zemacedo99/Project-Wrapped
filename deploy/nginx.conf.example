# Example Nginx reverse proxy config for Project-Wrapped.
# Copy to /etc/nginx/sites-available/project-wrapped, adjust the domain and
# upstream address, symlink into sites-enabled, then reload Nginx.
#
# This terminates TLS and forwards traffic to the app, which should be
# listening on the loopback interface or an internal network address
# (HOST=127.0.0.1 in .env, or the docker-compose "app" service).
#
# Obtain a certificate first, e.g. with certbot:
#   sudo certbot --nginx -d wrapped.example.com

server {
    listen 80;
    server_name wrapped.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name wrapped.example.com;

    ssl_certificate     /etc/letsencrypt/live/wrapped.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wrapped.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Needed for Vite's HMR websocket in dev; harmless in production.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
