# Project-Wrapped environment variables
# Copy this file to `.env` and adjust values as needed.
# `.env` is git-ignored and must never be committed.
#
# setup-and-start.ps1 / .sh create `.env` from this file automatically on
# first run and generate secure random values for POSTGRES_PASSWORD and
# SESSION_SECRET instead of using the placeholders below - you only need to
# edit this file by hand for manual/advanced setups.

# =============================================================================
# REQUIRED - the app will not start without these
# =============================================================================

# Full connection string used by the app (Drizzle ORM) and by `npm run db:push`.
# Must match the POSTGRES_* values below.
# - Full Docker Compose deployment (recommended, default): the containerised
#   app connects to the "db" service by its Compose network name - this value
#   is only used for host-run tooling (e.g. `docker compose exec` / psql) and
#   is overridden internally for the app container in docker-compose.yml.
# - Local development (-Dev / --dev): the app runs on the host and connects
#   via localhost, so this DATABASE_URL is what's actually used.
DATABASE_URL=postgresql://postgres:password@localhost:5432/project_wrapped

# Port the Express server (API + web app) listens on, and the host port
# published by Docker Compose.
PORT=5000

# Postgres container configuration (docker-compose.yml). Keep in sync with
# DATABASE_URL above. POSTGRES_PASSWORD is auto-generated by the setup
# scripts on first run - change it here only for manual setups.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=project_wrapped

# =============================================================================
# OPTIONAL
# =============================================================================

# Host port mapped to the database container's Postgres port (5432), bound to
# 127.0.0.1 only (see docker-compose.yml). Change if 5432 is already used by
# another Postgres instance on your machine.
POSTGRES_PORT=5432

# Interface the server binds to.
# - 0.0.0.0 (default): reachable from other devices on the LAN and from
#   containers/reverse proxies.
# - 127.0.0.1: restrict access to this machine only.
HOST=0.0.0.0

# Host port published by the OPTIONAL Caddy reverse proxy for HTTPS. Only used
# when you start with HTTPS enabled (setup-and-start.ps1 -Https, or
# `docker compose --profile https up -d`). The default deployment serves plain
# HTTP on PORT and does not start Caddy. Change only if 443 is already used by
# another service on this machine (IIS, another reverse proxy, VPN software,
# etc.) - setup-and-start.ps1 reports the owning process and lets you pick an
# alternative, e.g. 8443, with -Https -HttpsPort 8443.
APP_HTTPS_PORT=443

# IP address (or hostname) other devices should use to reach this deployment,
# e.g. this machine's LAN IP. Only affects what setup-and-start.ps1 prints and
# what the Caddyfile reports in logs - never affects how the server binds or
# which requests Caddy accepts (see Caddyfile). Auto-detected if left unset;
# override with setup-and-start.ps1 -AdvertisedHost <ip> if auto-detection
# picks the wrong network adapter (VPN/WSL/Hyper-V/Docker virtual adapters).
ADVERTISED_HOST=

# --- Remote access via ngrok (setup-and-start.ps1 -Ngrok / --ngrok) ---------
# Use ngrok when inbound access to this machine is blocked by a corporate
# firewall, VPN or VLAN. ngrok opens an OUTBOUND tunnel from this PC and gives
# you a public HTTPS URL that works from anywhere - no inbound firewall rule,
# server IP or LAN routing required. Requires ngrok installed on this host
# (https://ngrok.com/download) and a free account.

# Your ngrok auth token. If set, the setup script configures ngrok with it
# automatically (equivalent to a one-time `ngrok config add-authtoken <TOKEN>`).
# Get it from https://dashboard.ngrok.com/get-started/your-authtoken .
# Treat this like a password - never commit a real value.
NGROK_AUTHTOKEN=

# Optional: a reserved ngrok domain (paid feature) for a stable URL that does
# not change every restart, e.g. project-wrapped.ngrok.app. Leave blank to get
# a random *.ngrok-free.app URL each run.
NGROK_DOMAIN=

# STRONGLY RECOMMENDED when using ngrok: HTTP Basic Auth credentials in the
# form user:password. The app itself has NO login, so without this anyone who
# learns the public URL can use it (and any AZURE_DEVOPS_PAT set below). ngrok
# will prompt visitors for these credentials before letting them through.
NGROK_BASIC_AUTH=
# ---------------------------------------------------------------------------

# Azure DevOps connection defaults, used to prefill the "Connect to Azure
# DevOps" dialog. All optional - users can still type/override every field.

# Optional for Azure DevOps Cloud. Required for an on-premises Azure DevOps Server.
AZURE_DEVOPS_BASE_URL=https://tfsdavinci.eu.mt.mtnet

# Azure DevOps organization or on-premises collection name.
AZURE_DEVOPS_ORGANIZATION=LabTec New

# Default project name.
AZURE_DEVOPS_PROJECT=DaVinci On Iris

# Not required to start the app: an Azure DevOps PAT is normally entered in
# the UI when creating a wrapped, and is never sent back to the browser by
# the server (only a boolean "a PAT is configured" flag is). Set this only if
# you want a shared default for this deployment - never commit a real value.
# WARNING: this PAT is shared by every user of this deployed instance who
# leaves the PAT field blank/unchanged in the Azure DevOps dialog.
# Get your PAT from: https://dev.azure.com/{organization}/_usersSettings/tokens
# Or for on-premises: https://your-server/_usersSettings/tokens
# Required permissions: Code (Read), Work Items (Read)
AZURE_DEVOPS_PAT=

# =============================================================================
# AUTHENTICATION (Cloudflare Access) - see AUTHENTICATION.md
# =============================================================================

# How the app authenticates users. One of:
# - disabled (default): no authentication - the pre-existing behavior, only
#   acceptable for local use or a trusted LAN.
# - cloudflare-access: the app sits behind Cloudflare Zero Trust / Cloudflare
#   Access (email + one-time PIN at the edge). Every /api route except
#   /api/health and /api/auth/me then requires a Cloudflare Access JWT that
#   the server verifies against your team's public signing keys. Requires
#   CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD below - the app refuses to start
#   without them.
# - dev-bypass: local development only - injects DEV_AUTH_EMAIL as the
#   authenticated user without any verification. The app refuses to start in
#   this mode when NODE_ENV=production.
AUTH_MODE=disabled

# Your Cloudflare Zero Trust team domain, e.g. myteam.cloudflareaccess.com
# (just "myteam" also works). Found in Zero Trust dashboard > Settings >
# Custom Pages ("Team domain"). Not a secret.
CF_ACCESS_TEAM_DOMAIN=

# The Access application's Audience (AUD) tag - a 64-char hex string shown in
# Zero Trust dashboard > Access > Applications > (your app) > Overview.
# Identifies which Access application a JWT was issued for. Not a secret.
CF_ACCESS_AUD=

# AUTH_MODE=dev-bypass only: the email injected as the authenticated user for
# local development. Ignored in every other mode; never works in production.
DEV_AUTH_EMAIL=

# =============================================================================
# DEVELOPMENT-ONLY
# =============================================================================

# development | production. The setup scripts set this automatically
# (development for -Dev/--dev, production inside the Docker image) - you
# normally don't need to set it yourself.
NODE_ENV=development

# Reserved for future session/auth support (not currently read by the app).
# Auto-generated by the setup scripts on first run. If you enable sessions in
# the future, use a long random string here - never a guessable value.
SESSION_SECRET=dev-secret-key

# =============================================================================
# PRODUCTION / INTERNET DEPLOYMENT (see README.md "Internet deployment")
# =============================================================================
# The default Docker Compose deployment already includes a Caddy reverse
# proxy terminating HTTPS on APP_HTTPS_PORT with an internal CA (see
# Caddyfile) - suitable for LAN/VPN access by IP. There are no further
# app-specific production-only variables beyond NODE_ENV=production (set
# automatically by docker-compose.yml) and a strong POSTGRES_PASSWORD/
# SESSION_SECRET (auto-generated above).
#
# Making the app reachable from the public internet (a real domain name with
# a publicly-trusted certificate instead of the internal CA) is a separate,
# additional step - see deploy/nginx.conf.example and deploy/Caddyfile.example
# for that scenario, and README.md "Internet / production deployment".

